{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Cubott",
  "version": "1.0.0",
  "logo": {
    "navy": "#0A2F47",
    "blue": "#379ECF",
    "blueTop": "#3AA5D8",
    "shade": "#0A3F5E"
  },
  "color": {
    "navy": { "900": "#071427", "800": "#0B1F3B", "700": "#122B4F", "600": "#1B3A66" },
    "blue": { "50": "#EFF6FF", "100": "#DBEAFE", "200": "#BFDBFE", "300": "#93C5FD", "400": "#60A5FA", "500": "#3B82F6", "600": "#2563EB", "700": "#1D4ED8" },
    "slate": { "200": "#E2E8F0", "500": "#64748B" },
    "surface": { "DEFAULT": "#F8FAFC", "2": "#F1F5F9" },
    "white": "#FFFFFF",
    "status": { "success": "#16A34A", "warning": "#D97706", "danger": "#DC2626", "info": "#2563EB" }
  },
  "semantic": {
    "light": { "bg": "#F8FAFC", "bgElevated": "#FFFFFF", "fg": "#0B1F3B", "fgMuted": "#64748B", "border": "#E2E8F0", "primary": "#2563EB", "primaryHover": "#1D4ED8", "primaryFg": "#FFFFFF" },
    "dark": { "bg": "#071427", "bgElevated": "#0B1F3B", "fg": "#FFFFFF", "fgMuted": "rgba(255,255,255,0.6)", "border": "rgba(255,255,255,0.08)", "primary": "#FFFFFF", "primaryHover": "#EFF6FF", "primaryFg": "#0B1F3B" }
  },
  "font": {
    "sans": "Inter, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "trackingDisplay": "-0.03em",
    "trackingTight": "-0.02em"
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "stage": 32, "pill": 999 },
  "motion": { "ease": [0.16, 1, 0.3, 1], "fast": 0.3, "base": 0.5, "slow": 0.8 }
}
